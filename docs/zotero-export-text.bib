@article{valivarthiPicosecondSynchronizationSystem2022,
  title = {Picosecond Synchronization System for Quantum Networks},
  author = {Valivarthi, Raju and Narv{\'a}ez, Lautaro and Davis, Samantha I. and Lauk, Nikolai and Pe{\~n}a, Cristi{\'a}n and Xie, Si and Allmaras, Jason P. and Beyer, Andrew D. and Korzh, Boris and Mueller, Andrew and Rominsky, Mandy and Shaw, Matthew and Wollman, Emma E. and Spentzouris, Panagiotis and Oblak, Daniel and Sinclair, Neil and Spiropulu, Maria},
