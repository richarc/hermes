@misc{humberdLinkFreeMultiNodeTiming2026,
  title = {Link-{{Free Multi-Node Timing Synchronization}} for {{Scalable Quantum Networking}}},
  author = {Humberd, Jacob E. and Haq, Mohmad Junaid Ul and Estrada, Angel Fraire and Deitch, Ike and Li, Tian},
