+	for emitted.Load() == 0 && time.Now().Before(deadline) {
+		time.Sleep(5 * time.Millisecond)
+	}
+	if emitted.Load() == 0 {
+		t.Fatal("no emit after change")
+	}
+
+	s.WatchBibliography("", docPath) // stop
