+    </group>
+  </macro>
+  <!-- 3.2. Identifier (in parentheses) (APA 9.19) -->
+  <macro name="identifier">
+    <!-- (Secondary contributors; Database location; Genre no. 123; Report Series 123, Version, Edition, Volume, Page) -->
+    <group delimiter="; " prefix="(" suffix=")">
